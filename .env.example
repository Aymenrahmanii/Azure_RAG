# Copy to .env (git-ignored). Never put real secrets in this file.
ENVIRONMENT=local

# Local providers (week 1-3)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHROMA_PATH=.chroma

# Any OpenAI-compatible endpoint, e.g. Ollama: http://localhost:11434/v1 + model llama3.1
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Azure (week 4+): prefer Managed Identity / DefaultAzureCredential, no keys
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=

# API security (docs/security.md). AUTH_MODE=off is only allowed with ENVIRONMENT=local.
AUTH_MODE=off
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_PUBLIC_KEY=
AUTH_JWKS_URL=
ACL_RESTRICTED=
RATE_LIMIT_PER_MINUTE=20
AUDIT_SALT=
